{
  "name": "supplyloop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.mjs",
    "test:api": "node --env-file=.env.test.local --test --test-concurrency=1 tests/api/acceptance.test.mjs",
    "test:registration": "node --env-file=.env.test.local --env-file=.env.registration.local --env-file=.env.email-test.local --test --test-concurrency=1 tests/api/registration.test.mjs",
    "test:enrollment-security": "node scripts/operator/test-email-enrollment-local.mjs",
    "test:reset-operator": "node --test tests/operator/reset-registrations.test.mjs",
    "test:reset-security": "node scripts/operator/test-reset-registrations-local.mjs",
    "demo:provision": "node --env-file=.env.operator.local scripts/operator/provision.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.81.0",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  }
}
